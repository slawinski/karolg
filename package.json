{
  "name": "karolg",
  "version": "1.0.0",
  "private": true,
  "description": "Carla Gorecka portfolio — Next.js + Payload CMS",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "media:backfill-colors": "tsx scripts/reprocess-media.ts --kind=image --missing-color",
    "media:reprocess": "tsx scripts/reprocess-media.ts",
    "media:worker": "payload jobs:run --queue media-processing --limit 1",
    "test": "vitest run",
    "test:slugs": "tsx scripts/verify-photoshoot-slugs.ts",
    "test:social-metadata": "tsx scripts/verify-social-metadata.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts --browser=chromium",
    "test:browser:webkit": "vitest run --config vitest.browser.config.ts --browser=webkit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "^7.0.3",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "next": "16.4.0",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.64.0",
    "tsx": "^4.20.6",
    "typescript": "5.7.3",
    "vitest": "^4.1.11",
    "vitest-browser-react": "2.3.0"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.16",
      "undici": "7.29.1"
    },
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
